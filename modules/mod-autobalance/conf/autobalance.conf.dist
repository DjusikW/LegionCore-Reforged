###################################################################################################
# mod-autobalance configuration
#
# Copy this file to autobalance.conf next to worldserver.conf to change a value: the .dist file
# is read first (defaults), then autobalance.conf over it. ".reload config" reads both again.
#
# Scales creatures of dungeons and raids to the actual number of players (GMs with .gm on are
# not counted), like AzerothCore mod-autobalance (without level scaling). Health, armor, mana
# and the damage the creatures deal to players and their pets (melee, spells, periodic) are
# multiplied by
#     curve = (tanh((players - Tuned * InflectionPoint) / (Tuned / 5 * 1.5)) + 1) / 2
# when players < Tuned, otherwise curve = 1; the result is then multiplied by StatModifier.*.
# Tuned = 5 for dungeons, 10 for flexible raids (Normal/Heroic/LFR; above 10 players the core
# already adds health per player), 20 for Mythic raids.
# Example with InflectionPoint 0.5: dungeon solo 0.12, duo 0.34, trio 0.66;
#                                   flexible raid solo 0.07, duo 0.12, 5 players 0.50.
#
# Categories:  Dungeon       - Normal 5-player dungeons
#              DungeonHeroic - Heroic, Mythic and Mythic Keystone dungeons
#              Raid          - LFR and Normal raids (and the other non-heroic raids)
#              RaidHeroic    - Heroic and Mythic raids (and old 10/25 Heroic)
# Every *Heroic setting that is missing takes the value of its non-heroic one.
# Changes are applied by .reload config and when somebody enters or leaves the instance.
###################################################################################################

[worldserver]

#
#    AutoBalance.Enable
#        Description: Enable the scaling.
#        Default:     0 - (Disabled, the stats are untouched)
#                     1 - (Enabled)

AutoBalance.Enable = 0

#    AutoBalance.Enable.Dungeon / .DungeonHeroic / .Raid / .RaidHeroic
#        Description: Scale this category (scenarios are never scaled).
#        Default:     1 - (Enabled)

AutoBalance.Enable.Dungeon = 1
AutoBalance.Enable.DungeonHeroic = 1
AutoBalance.Enable.Raid = 1
AutoBalance.Enable.RaidHeroic = 1

#    AutoBalance.ShowAura
#        Description: Show the aura 900100 "AutoBalance" on scaled creatures, its stack count is the
#                     number of players (hotfix in sql/hotfixes of this module).
#        Default:     1 - (Enabled)

AutoBalance.ShowAura = 1

#    AutoBalance.MinPlayers
#        Description: Count at least this many players (e.g. 2 makes a solo run as hard as a duo).
#        Default:     1

AutoBalance.MinPlayers = 1

#    AutoBalance.InflectionPoint.<Category>
#        Description: Fraction of the tuned group size where the creatures have half of their
#                     stats. Lower - stronger creatures for small groups, higher - weaker.
#        Default:     0.5
#    AutoBalance.InflectionPoint.<Category>.BossModifier
#        Description: Multiplier of the inflection point for bosses (below 1 - bosses stay stronger).
#        Default:     1.0

AutoBalance.InflectionPoint.Dungeon = 0.5
AutoBalance.InflectionPoint.Dungeon.BossModifier = 1.0
AutoBalance.InflectionPoint.DungeonHeroic = 0.5
AutoBalance.InflectionPoint.DungeonHeroic.BossModifier = 1.0
AutoBalance.InflectionPoint.Raid = 0.5
AutoBalance.InflectionPoint.Raid.BossModifier = 1.0
AutoBalance.InflectionPoint.RaidHeroic = 0.5
AutoBalance.InflectionPoint.RaidHeroic.BossModifier = 1.0

#    AutoBalance.StatModifier.<Category>.Health / .Damage / .Armor / .Mana
#        Description: Extra multipliers on top of the curve for normal creatures
#                     (applied in every scaled instance).
#    AutoBalance.StatModifier.<Category>.Boss.Health / .Boss.Damage / .Boss.Armor / .Boss.Mana
#        Description: The same for bosses.
#        Default:     1.0

AutoBalance.StatModifier.Dungeon.Health = 1.0
AutoBalance.StatModifier.Dungeon.Damage = 1.0
AutoBalance.StatModifier.Dungeon.Armor = 1.0
AutoBalance.StatModifier.Dungeon.Mana = 1.0
AutoBalance.StatModifier.Dungeon.Boss.Health = 1.0
AutoBalance.StatModifier.Dungeon.Boss.Damage = 1.0
AutoBalance.StatModifier.Dungeon.Boss.Armor = 1.0
AutoBalance.StatModifier.Dungeon.Boss.Mana = 1.0

AutoBalance.StatModifier.DungeonHeroic.Health = 1.0
AutoBalance.StatModifier.DungeonHeroic.Damage = 1.0
AutoBalance.StatModifier.DungeonHeroic.Armor = 1.0
AutoBalance.StatModifier.DungeonHeroic.Mana = 1.0
AutoBalance.StatModifier.DungeonHeroic.Boss.Health = 1.0
AutoBalance.StatModifier.DungeonHeroic.Boss.Damage = 1.0
AutoBalance.StatModifier.DungeonHeroic.Boss.Armor = 1.0
AutoBalance.StatModifier.DungeonHeroic.Boss.Mana = 1.0

AutoBalance.StatModifier.Raid.Health = 1.0
AutoBalance.StatModifier.Raid.Damage = 1.0
AutoBalance.StatModifier.Raid.Armor = 1.0
AutoBalance.StatModifier.Raid.Mana = 1.0
AutoBalance.StatModifier.Raid.Boss.Health = 1.0
AutoBalance.StatModifier.Raid.Boss.Damage = 1.0
AutoBalance.StatModifier.Raid.Boss.Armor = 1.0
AutoBalance.StatModifier.Raid.Boss.Mana = 1.0

AutoBalance.StatModifier.RaidHeroic.Health = 1.0
AutoBalance.StatModifier.RaidHeroic.Damage = 1.0
AutoBalance.StatModifier.RaidHeroic.Armor = 1.0
AutoBalance.StatModifier.RaidHeroic.Mana = 1.0
AutoBalance.StatModifier.RaidHeroic.Boss.Health = 1.0
AutoBalance.StatModifier.RaidHeroic.Boss.Damage = 1.0
AutoBalance.StatModifier.RaidHeroic.Boss.Armor = 1.0
AutoBalance.StatModifier.RaidHeroic.Boss.Mana = 1.0

#    AutoBalance.MinHealthModifier / MinDamageModifier / MinArmorModifier / MinManaModifier
#        Description: Lowest allowed multiplier.
#        Default:     0.01

AutoBalance.MinHealthModifier = 0.01
AutoBalance.MinDamageModifier = 0.01
AutoBalance.MinArmorModifier = 0.01
AutoBalance.MinManaModifier = 0.01

